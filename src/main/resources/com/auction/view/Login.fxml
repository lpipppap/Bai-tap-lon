                  <Region prefHeight="0.0" prefWidth="15.0" />
            
                  <ToggleButton fx:id="bidder" mnemonicParsing="false" onAction="#bidderButton" prefHeight="40.0" prefWidth="100.0" style="-fx-border-color: #02fdba;" text="Bidder" textFill="#02fdba">
                     <toggleGroup>
                        <ToggleGroup fx:id="role" />
                     </toggleGroup>
                     <cursor>
                        <Cursor fx:constant="OPEN_HAND" />
                     </cursor>
                  </ToggleButton>
            
                  <ToggleButton fx:id="seller" mnemonicParsing="false" onAction="#sellerButton" prefHeight="40.0" prefWidth="100.0" style="-fx-border-color: #02fdba;" text="Seller" textFill="#02fdba" toggleGroup="$role">
                     <cursor>
                        <Cursor fx:constant="OPEN_HAND" />
                     </cursor>
                  </ToggleButton>
               </children>
            </HBox>
            <Region layoutX="10.0" layoutY="217.0" prefHeight="10.0" prefWidth="0.0" />
            <TextField fx:id="email" prefHeight="60.0" prefWidth="500.0" promptText="Email" style="-fx-background-color: #000000; -fx-border-radius: 50; -fx-border-color: #02fdba;">
               <font>
                  <Font size="18.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="TEXT" />
               </cursor>
            </TextField>
            <Region layoutX="10.0" layoutY="327.0" prefHeight="10.0" prefWidth="0.0" />
            <StackPane alignment="CENTER_RIGHT">
               <children>
                  <TextField fx:id="pwShown" prefHeight="60.0" prefWidth="500.0" promptText="Password" style="-fx-background-color: #0000; -fx-border-radius: 50; -fx-border-color: #02fdba;">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </TextField>
                  <PasswordField fx:id="pwHidden" prefHeight="60.0" prefWidth="500.0" promptText="Password" style="-fx-background-color: #000000; -fx-border-color: #02fdba; -fx-border-radius: 50;">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <cursor>
                        <Cursor fx:constant="TEXT" />
                     </cursor>
                  </PasswordField>
                  <Button fx:id="lever" mnemonicParsing="false" onAction="#togglePassword" style="-fx-background-color: transparent;" text="Show" textFill="#02fdba">
                     <cursor>
