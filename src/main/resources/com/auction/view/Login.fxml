<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="600.0" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.LoginController">
   <children>
      <VBox alignment="CENTER" layoutX="50.0" layoutY="14.0" spacing="20.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="60.0">
         <children>
            <Region prefHeight="10.0" prefWidth="0.0" />
            <Label alignment="CENTER" contentDisplay="CENTER" maxWidth="-Infinity" minWidth="-Infinity" prefHeight="50.0" prefWidth="600.0" text="HỆ THỐNG ĐẤU GIÁ TRỰC TUYẾN" textFill="WHITE" wrapText="true">
               <font>
                  <Font size="36.0" />
               </font>
            </Label>
            <Label alignment="CENTER" contentDisplay="CENTER" text="Welcome back!" textFill="#02fdba">
               <font>
                  <Font size="36.0" />
               </font>
            </Label>
            <Region layoutX="10.0" layoutY="93.0" prefHeight="10.0" prefWidth="0.0" />
            <HBox alignment="CENTER">
               <children>
            
                  <Label text="You want to login as:" textFill="#02fdba">
